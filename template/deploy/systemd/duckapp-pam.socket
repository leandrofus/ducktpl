# The root PAM helper (duckapp pam-helper), one process per connection.
# The gateway runs as duckapp and only reaches it through this socket.
[Unit]
Description=DuckApp PAM helper socket

[Socket]
ListenStream=/run/duckapp/pam.sock
SocketUser=root
SocketGroup=duckapp
SocketMode=0660
Accept=yes

[Install]
WantedBy=sockets.target
